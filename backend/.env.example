# ─── Application ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── MongoDB Atlas ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vcsa?retryWrites=true&w=majority

# ─── Transcription Service ───────────────────────────────────
#   Development  → TRANSCRIPTION_PROVIDER=local  (whisper.cpp HTTP server, zero API cost)
#   Production   → TRANSCRIPTION_PROVIDER=openai (OpenAI Whisper API)
#
#   To run local Whisper, start whisper.cpp server:
#     ./server -m models/ggml-base.en.bin -l auto --port 8080
#
TRANSCRIPTION_PROVIDER=local
WHISPER_BASE_URL=http://localhost:8080
WHISPER_MODEL=base

# For production swap (set TRANSCRIPTION_PROVIDER=openai):
OPENAI_API_KEY=sk-...

# ─── AI / NLP Service ────────────────────────────────────────
#   Development  → AI_PROVIDER=ollama  (local Ollama, zero API cost)
#   Production   → AI_PROVIDER=openai  (OpenAI GPT-4o-mini)
#                  AI_PROVIDER=anthropic (Anthropic Claude)
#
#   Pull the model locally first:
#     ollama pull gemma:2b
#
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma:2b

# For production swap (set AI_PROVIDER=openai):
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Session ────────────────────────────────────────────────
DEFAULT_USER_ID=local-dev-user
